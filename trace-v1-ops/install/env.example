# 睿码溯源系统 - 环境变量配置
# 生产环境请复制此文件为 .env 并修改相应配置

# 数据库配置
DATABASE_URL=postgresql://trace_user:trace_pass_2024@db:5432/trace_db
POSTGRES_USER=trace_user
POSTGRES_PASSWORD=trace_pass_2024
POSTGRES_DB=trace_db

# 服务端口
BACKEND_PORT=8000
FRONTEND_PORT=80

# JWT密钥 (生产环境请修改为随机字符串)
JWT_SECRET_KEY=rutrace_secret_key_change_in_production_2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis配置 (可选)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 系统配置
SYSTEM_NAME=睿码溯源系统
SYSTEM_VERSION=V1.0.0
DEBUG_MODE=false

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# 安全配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
ALLOWED_HOSTS=["*"]